# `nix build` symlinks (root flake + per-skill sub-flakes)
/result
/result-*
/skills/*/result
/skills/*/result-*

# Project-scope skills the dev-shell reconcile hook installs; the skills'
# preferences files beside them are the project's own.
/.agents/skills/*
!/.agents/skills/*.preferences.md
/.claude/skills/

# Per-branch git worktrees (see `using-git-worktrees` skill).
/.worktrees/

# Clojure CLI classpath cache for the evals.
/evals/.cpcache/
