{"t01-project" "(from :customers [customer-name])"
"t02-literal-filter" "(-> (from :customers [{:xt/id id} customer-name city]) (where (= city \"London\")) (return id customer-name))"
"t03-where" "(-> (from :orders [{:xt/id id} order-value]) (where (> order-value 500)) (return id order-value))"
"t04-order-limit" "(-> (from :orders [{:xt/id id} order-value]) (order-by {:val order-value, :dir :desc}) (limit 2) (return id order-value))"
"t05-offset" "(-> (from :orders [{:xt/id id} order-value]) (order-by order-value) (offset 1) (limit 2) (return id order-value))"
"t06-aggregate-count" "(-> (from :orders [status]) (aggregate status {:n (row-count)}) (return status n))"
"t07-join-sum" "(-> (unify (from :customers [{:xt/id cid} customer-name]) (from :orders [{:customer-id cid} order-value])) (aggregate customer-name {:total (sum order-value)}) (return customer-name total))"
"t08-left-join" "(-> (from :customers [{:xt/id cid} customer-name]) (left-join (from :orders [{:xt/id order-id, :customer-id cid}]) [cid]) (return customer-name order-id))"
"t09-not-exists" "(-> (from :customers [{:xt/id cid} customer-name]) (where (not (exists? (from :orders [{:customer-id cid}]) [cid]))) (return customer-name))"
"t10-exists" "(-> (from :customers [{:xt/id cid} customer-name]) (where (exists? (from :orders [{:customer-id cid, :status \"shipped\"}]) [cid])) (aggregate customer-name) (return customer-name))"
"t11-unify-where-or" "(-> (unify (from :orders [{:xt/id order-id} customer-id order-value]) (from :customers [{:xt/id customer-id} customer-name vip])) (where (or (= vip true) (> order-value 1000))) (return order-id customer-name))"
"t12-concat" "(-> (from :customers [customer-name city]) (return {:label (concat customer-name \" (\" city \")\")}))"
"t13-star-without" "(-> (from :orders [*]) (without :tags) (return xt/id customer-id order-value status))"
"t14-unnest" "(-> (from :orders [{:xt/id order-id} tags]) (unnest {tag tags}) (return {:order-id order-id} tag))"
"t15-rel" "(-> (unify (rel [{:product \"widget\", :category \"tools\"} {:product \"gadget\", :category \"toys\"}] [product category]) (from :prices [{:xt/id product} price])) (return product category price))"
"t16-current-version" "(-> (from :prices [{:xt/id product} price]) (return product price))"
"t17-valid-time-at" "(-> (from :prices {:bind [{:xt/id product} price], :for-valid-time (at #inst \"2020-07-01T00:00:00Z\")}) (return product price))"
"t18-all-time-history" "(-> (from :prices {:bind [{:xt/id product} price xt/valid-from xt/valid-to], :for-valid-time :all-time}) (where (= product \"widget\")) (order-by xt/valid-from) (return price {:valid-from xt/valid-from, :valid-to xt/valid-to}))"
"t19-valid-time-in" "(-> (from :prices {:bind [{:xt/id product} price], :for-valid-time (in #inst \"2021-01-01T00:00:00Z\" #inst \"2022-01-01T00:00:00Z\")}) (where (> price 40)) (aggregate product) (return product))"
"t20-join-rename" "(-> (unify (from :posts [{:xt/id post-id} title author-id]) (from :customers [{:xt/id author-id} customer-name])) (return title customer-name))"
"t21-count-with-zero" "(-> (from :posts [{:xt/id post-id} title]) (left-join (from :comments [{:xt/id cid, :post-id post-id}]) [post-id]) (aggregate title {:n (count cid)}) (return title n))"
"t22-nested-field" "(-> (from :posts [title meta]) (where (= (. meta :lang) \"en\")) (return title))"
"t23-siblings-left-join" "(-> (from :people [{:xt/id person} parent]) (left-join (-> (from :people [{:xt/id sibling, :parent parent}]) (where (<> sibling person))) [parent]) (return {:person person} {:sibling sibling}))"
"t24-avg" "(-> (unify (from :posts [{:xt/id post-id} title]) (from :comments [{:post-id post-id} rating])) (aggregate title {:avg-rating (avg rating)}) (return title avg-rating))"
"t25-order-desc" "(-> (from :customers [customer-name]) (order-by {:val customer-name, :dir :desc}))"
"t26-max-no-group" "(-> (from :orders [order-value]) (aggregate {:max-value (max order-value)}))"
"t27-count-distinct" "(-> (from :customers [city]) (aggregate {:n (count-distinct city)}))"
"t28-array-contains" "(-> (from :orders [{:xt/id order-id} tags]) (where (in \"gift\" tags)) (return {:order-id order-id}))"
"t29-arithmetic" "(-> (from :orders [{:xt/id order-id} order-value]) (return {:order-id order-id} order-value {:tax (* order-value 0.2)}))"
"t30-like" "(-> (from :customers [customer-name]) (where (or (like customer-name \"C%\") (like customer-name \"D%\"))) (return customer-name))"
"t31-scalar-subquery" "(-> (from :orders [{:xt/id order-id, :customer-id cid}]) (return {:order-id order-id} {:customer-name (q (-> (from :customers [{:xt/id cid} customer-name]) (return customer-name)))}))"
"t32-exists-filtered" "(-> (from :posts [{:xt/id post-id} title]) (where (exists? (from :comments [{:post-id post-id, :rating 5}]) [post-id])) (return title))"
"t33-nested-compare" "(-> (from :posts [title meta]) (where (> (. meta :words) 100)) (return title))"
"t34-subquery-count-filter" "(-> (from :customers [{:xt/id cid} customer-name]) (where (>= (q (-> (from :orders [{:customer-id cid}]) (aggregate {:n (row-count)}) (return n))) 2)) (return customer-name))"
"t35-subquery-max" "(-> (from :customers [{:xt/id cid} customer-name]) (return customer-name {:top (q (-> (from :orders [{:customer-id cid} order-value]) (aggregate {:top (max order-value)}) (return top)))}))"
"t36-not-exists-filtered" "(-> (from :customers [{:xt/id cid} customer-name]) (where (not (exists? (from :orders [{:customer-id cid, :status \"pending\"}]) [cid]))) (return customer-name))"
"t37-exists-two-args" "(-> (from :customers [{:xt/id cid} customer-name city]) (where (exists? (-> (from :customers [{:xt/id other-id, :city city, :vip true}]) (where (<> other-id cid))) [city cid])) (return customer-name))"
"t38-count-zero" "(-> (from :customers [{:xt/id cid} customer-name]) (return customer-name {:n (q (-> (from :orders [{:customer-id cid, :status \"shipped\"}]) (aggregate {:n (row-count)}) (return n)))}))"
"t39-above-average" "(-> (from :orders [{:xt/id id} order-value]) (where (> order-value (q (-> (from :orders [order-value]) (aggregate {:avg (avg order-value)}) (return avg))))) (return id order-value))"
"t40-argmax-per-group" "(-> (unify (from :customers [{:xt/id cid} customer-name]) (from :orders [{:xt/id order-id, :customer-id cid} order-value])) (aggregate customer-name {:order-id (arg-max order-id order-value)}) (return customer-name order-id))"
"t41-with-without-nested" "(-> (from :posts [* meta]) (with {:lang (. meta :lang)}) (without :meta) (return xt/id title author-id lang))"
"t42-nested-group" "(-> (from :posts [meta]) (with {:lang (. meta :lang), :words (. meta :words)}) (aggregate lang {:total (sum words)}) (return lang total))"
"t43-nested-employee" "(-> (from :employees [name address]) (where (= (. address :country) \"UK\")) (return name))"
"t44-vector-first" "(-> (from :orders [{:xt/id order-id} tags]) (return {:order-id order-id} {:first-tag (nth tags 0)}))"
"t45-vector-length" "(-> (from :orders [{:xt/id order-id} tags]) (return {:order-id order-id} {:n (cardinality tags)}))"
"t46-unnest-count" "(-> (from :orders [{:xt/id order-id} tags]) (unnest {tag tags}) (aggregate tag {:n (count-distinct order-id)}) (return tag n))"
"t47-unnest-employees" "(-> (from :employees [{:xt/id eid} skills]) (unnest {skill skills}) (aggregate skill {:n (count-distinct eid)}) (return skill n))"
"t48-rel-literal-join" "(-> (unify (from :customers [{:xt/id cid} customer-name city]) (rel [{:city \"London\", :country \"UK\"} {:city \"Paris\", :country \"France\"}] [city country])) (return customer-name country))"
"t49-parameter" "(-> (from :orders [{:xt/id order-id} order-value]) (where (>= order-value $min)) (return order-id))"
"t50-valid-time-from" "(-> (from :prices {:bind [{:xt/id product} price], :for-valid-time (in #inst \"2022-06-01T00:00:00Z\" nil)}) (return product price))"
"t51-current-since" "(-> (from :prices {:bind [{:xt/id product} xt/valid-from]}) (return product {:since xt/valid-from}))"
"t52-min-ever" "(-> (from :prices {:bind [{:xt/id product} price], :for-valid-time :all-time}) (aggregate product {:lowest (min price)}) (return product lowest))"
"t53-salary-at" "(-> (unify (from :employees [{:xt/id eid} name]) (from :salaries {:bind [{:xt/id eid} salary], :for-valid-time (at #inst \"2022-06-01T00:00:00Z\")})) (return name salary))"
"t54-system-time-all" "(-> (from :salaries {:bind [{:xt/id \"e3\"} salary], :for-valid-time (at #inst \"2022-06-01T00:00:00Z\"), :for-system-time :all-time}) (aggregate salary) (return salary))"
"t55-top-salaries" "(-> (unify (from :employees [{:xt/id eid} name]) (from :salaries [{:xt/id eid} salary])) (order-by {:val salary, :dir :desc}) (limit 2) (return name salary))"
"t56-left-join-manager" "(-> (from :employees [{:xt/id eid} name manager-id]) (left-join (from :employees [{:xt/id manager-id, :name manager-name}]) [manager-id]) (return name manager-name))"
"t57-grand-manager" "(-> (unify (from :employees [name manager-id]) (from :employees [{:xt/id manager-id, :manager-id grand-id}]) (from :employees [{:xt/id grand-id, :name grand-manager}])) (return name grand-manager))"
"t58-all-reports" "(-> (rec :reports [eid] (unify (from :employees [{:xt/id eid, :manager-id \"e1\"}]) (unify (from :reports [{:eid mgr}]) (from :employees [{:xt/id eid, :manager-id mgr}])))) (unify (from :employees [{:xt/id eid} name])) (return name))"
"t59-pull-many" "(-> (from :posts [{:xt/id post-id} title]) (left-join (from :comments [{:post-id post-id} body rating]) [post-id]) (order-by {:val rating, :dir :desc}) (aggregate title {:comments (pull {:body body, :rating rating})}) (return title comments))"
"t60-pull-one" "(-> (unify (from :orders [{:xt/id order-id, :customer-id cid}]) (from :customers [{:xt/id cid} customer-name city])) (return order-id {:customer {:customer-name customer-name, :city city}}))"}
