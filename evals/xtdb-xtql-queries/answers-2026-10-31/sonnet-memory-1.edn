{"t01-project" "(from :customers [customer-name])"
 "t02-literal-filter" "(from :customers [{:xt/id id} customer-name {:city \"London\"}])"
 "t03-where" "(-> (from :orders [{:xt/id id} order-value]) (where (> order-value 500)))"
 "t04-order-limit" "(-> (from :orders [{:xt/id id} order-value]) (order-by {:val order-value :dir :desc}) (limit 2))"
 "t05-offset" "(-> (from :orders [{:xt/id id} order-value]) (order-by order-value) (offset 1) (limit 2))"
 "t06-aggregate-count" "(-> (from :orders [status]) (aggregate status {:n (row-count)}))"
 "t07-join-sum" "(-> (unify (from :customers [{:xt/id cid} customer-name]) (from :orders [{:customer-id cid} order-value])) (aggregate cid customer-name {:total (sum order-value)}) (return customer-name total))"
 "t08-left-join" "(-> (from :customers [{:xt/id cid} customer-name]) (left-join (from :orders [{:xt/id order-id :customer-id cid}]) [cid]) (return customer-name order-id))"
 "t09-not-exists" "(-> (from :customers [{:xt/id cid} customer-name]) (anti-join (from :orders [{:customer-id cid}]) [cid]) (return customer-name))"
 "t10-exists" "(-> (from :customers [{:xt/id cid} customer-name]) (semi-join (from :orders [{:customer-id cid :status \"shipped\"}]) [cid]) (return customer-name))"
 "t11-unify-where-or" "(-> (unify (from :orders [{:xt/id order-id :customer-id cid} order-value]) (from :customers [{:xt/id cid} customer-name vip])) (where (or vip (> order-value 1000))) (return order-id customer-name))"
 "t12-concat" "(-> (from :customers [customer-name city]) (return {:label (concat customer-name \" (\" city \")\")}))"
 "t13-star-without" "(-> (from :orders [*]) (without tags))"
 "t14-unnest" "(-> (from :orders [{:xt/id order-id} tags]) (unnest {:tag tags}) (return order-id tag))"
 "t15-rel" "(-> (unify (rel [{:product \"widget\" :category \"tools\"} {:product \"gadget\" :category \"toys\"}] [product category]) (from :prices [{:xt/id product} price])) (return product category price))"
 "t16-current-version" "(from :prices [{:xt/id product} price])"
 "t17-valid-time-at" "(from :prices {:bind [{:xt/id product} price] :for-valid-time (at #inst \"2020-07-01T00:00:00Z\")})"
 "t18-all-time-history" "(-> (from :prices {:bind [{:xt/id \"widget\"} price {:xt/valid-from valid-from} {:xt/valid-to valid-to}] :for-valid-time :all-time}) (order-by valid-from) (return price valid-from valid-to))"
 "t19-valid-time-in" "(-> (from :prices {:bind [{:xt/id product} price] :for-valid-time (in #inst \"2021-01-01T00:00:00Z\" #inst \"2022-01-01T00:00:00Z\")}) (where (> price 40)) (aggregate product {:c (row-count)}) (return product))"
 "t20-join-rename" "(-> (unify (from :posts [title {:author-id cid}]) (from :customers [{:xt/id cid} customer-name])) (return title customer-name))"
 "t21-count-with-zero" "(-> (from :posts [{:xt/id pid} title]) (left-join (from :comments [{:post-id pid :xt/id cmt}]) [pid]) (aggregate pid title {:n (count cmt)}) (return title n))"
 "t22-nested-field" "(-> (from :posts [title meta]) (where (= (. meta :lang) \"en\")) (return title))"
 "t23-siblings-left-join" "(-> (from :people [{:xt/id person} parent]) (left-join (-> (from :people [{:xt/id sibling :parent $parent}]) (where (<> sibling $person))) {:args [person parent] :bind [sibling]}) (return person sibling))"
 "t24-avg" "(-> (unify (from :posts [{:xt/id pid} title]) (from :comments [{:post-id pid} rating])) (aggregate pid title {:avg-rating (avg rating)}) (return title avg-rating))"
 "t25-order-desc" "(-> (from :customers [customer-name]) (order-by {:val customer-name :dir :desc}))"
 "t26-max-no-group" "(-> (from :orders [order-value]) (aggregate {:max-value (max order-value)}))"
 "t27-count-distinct" "(-> (from :customers [city]) (aggregate {:n (count-distinct city)}))"
 "t28-array-contains" "(-> (from :orders [{:xt/id order-id} tags]) (unnest {:tag tags}) (where (= tag \"gift\")) (return order-id))"
 "t29-arithmetic" "(-> (from :orders [{:xt/id order-id} order-value]) (with {:tax (* order-value 0.2)}) (return order-id order-value tax))"
 "t30-like" "(-> (from :customers [customer-name]) (where (or (like customer-name \"C%\") (like customer-name \"D%\"))))"
 "t31-scalar-subquery" "(-> (from :orders [{:xt/id order-id} customer-id]) (with {:customer-name (q (from :customers [{:xt/id $cid} customer-name]) {:args [{:cid customer-id}]})}) (return order-id customer-name))"
 "t32-exists-filtered" "(-> (from :posts [{:xt/id pid} title]) (semi-join (from :comments [{:post-id pid :rating 5}]) [pid]) (return title))"
 "t33-nested-compare" "(-> (from :posts [title meta]) (where (> (. meta :words) 100)) (return title))"
 "t34-subquery-count-filter" "(-> (from :customers [{:xt/id cid} customer-name]) (where (>= (q (-> (from :orders [{:customer-id $cid}]) (aggregate {:c (row-count)})) {:args [cid]}) 2)) (return customer-name))"
 "t35-subquery-max" "(-> (from :customers [{:xt/id cid} customer-name]) (with {:top (q (-> (from :orders [{:customer-id $cid} order-value]) (aggregate {:m (max order-value)})) {:args [cid]})}) (return customer-name top))"
 "t36-not-exists-filtered" "(-> (from :customers [{:xt/id cid} customer-name]) (anti-join (from :orders [{:customer-id cid :status \"pending\"}]) [cid]) (return customer-name))"
 "t37-exists-two-args" "(-> (from :customers [{:xt/id cid} customer-name city]) (where (exists? (-> (from :customers [{:xt/id other :city $city :vip true}]) (where (<> other $cid))) {:args [city cid]})) (return customer-name))"
 "t38-count-zero" "(-> (from :customers [{:xt/id cid} customer-name]) (with {:n (q (-> (from :orders [{:customer-id $cid :status \"shipped\"}]) (aggregate {:c (row-count)})) {:args [cid]})}) (return customer-name n))"
 "t39-above-average" "(-> (from :orders [{:xt/id id} order-value]) (where (> order-value (q (-> (from :orders [order-value]) (aggregate {:a (avg order-value)}))))))"
 "t40-argmax-per-group" "(-> (unify (from :customers [{:xt/id cid} customer-name]) (from :orders [{:xt/id order-id :customer-id cid} order-value])) (where (= order-value (q (-> (from :orders [{:customer-id $cid} order-value]) (aggregate {:m (max order-value)})) {:args [cid]}))) (return customer-name order-id))"
 "t41-with-without-nested" "(-> (from :posts [*]) (with {:lang (. meta :lang)}) (without meta))"
 "t42-nested-group" "(-> (from :posts [meta]) (with {:lang (. meta :lang) :words (. meta :words)}) (aggregate lang {:total (sum words)}))"
 "t43-nested-employee" "(-> (from :employees [name address]) (where (= (. address :country) \"UK\")) (return name))"
 "t44-vector-first" "(-> (from :orders [{:xt/id order-id} tags]) (with {:first-tag (nth tags 0)}) (return order-id first-tag))"
 "t45-vector-length" "(-> (from :orders [{:xt/id order-id} tags]) (with {:n (cardinality tags)}) (return order-id n))"
 "t46-unnest-count" "(-> (from :orders [tags]) (unnest {:tag tags}) (aggregate tag {:n (row-count)}))"
 "t47-unnest-employees" "(-> (from :employees [skills]) (unnest {:skill skills}) (aggregate skill {:n (row-count)}))"
 "t48-rel-literal-join" "(-> (unify (from :customers [customer-name city]) (rel [{:city \"London\" :country \"UK\"} {:city \"Paris\" :country \"France\"}] [city country])) (return customer-name country))"
 "t49-parameter" "(-> (from :orders [{:xt/id order-id} order-value]) (where (>= order-value $min-value)) (return order-id))"
 "t50-valid-time-from" "(from :prices {:bind [{:xt/id product} price] :for-valid-time (from #inst \"2022-06-01T00:00:00Z\")})"
 "t51-current-since" "(from :prices [{:xt/id product} price {:xt/valid-from since}])"
 "t52-min-ever" "(-> (from :prices {:bind [{:xt/id product} price] :for-valid-time :all-time}) (aggregate product {:lowest (min price)}))"
 "t53-salary-at" "(-> (unify (from :employees [{:xt/id eid} name]) (from :salaries {:bind [{:xt/id eid} salary] :for-valid-time (at #inst \"2022-06-01T00:00:00Z\")})) (return name salary))"
 "t54-system-time-all" "(-> (from :salaries {:bind [{:xt/id \"e3\"} salary] :for-valid-time (at #inst \"2022-06-01T00:00:00Z\") :for-system-time :all-time}) (aggregate salary {:c (row-count)}) (return salary))"
 "t55-top-salaries" "(-> (unify (from :employees [{:xt/id eid} name]) (from :salaries [{:xt/id eid} salary])) (order-by {:val salary :dir :desc}) (limit 2) (return name salary))"
 "t56-left-join-manager" "(-> (from :employees [name manager-id]) (left-join (from :employees [{:xt/id manager-id :name manager-name}]) [manager-id]) (return name manager-name))"
 "t57-grand-manager" "(-> (unify (from :employees [name manager-id]) (from :employees [{:xt/id manager-id :manager-id gid}]) (from :employees [{:xt/id gid :name grand-manager}])) (return name grand-manager))"
 "t58-all-reports" "(-> (from :employees [name manager-id]) (left-join (from :employees [{:xt/id manager-id :manager-id m2}]) [manager-id]) (left-join (from :employees [{:xt/id m2 :manager-id m3}]) [m2]) (where (or (= manager-id \"e1\") (= m2 \"e1\") (= m3 \"e1\"))) (return name))"
 "t59-pull-many" "(-> (from :posts [{:xt/id pid} title]) (with {:comments (pull* (-> (from :comments [{:post-id $pid} body rating]) (order-by {:val rating :dir :desc})) {:args [pid]})}) (return title comments))"
 "t60-pull-one" "(-> (from :orders [{:xt/id order-id} customer-id]) (with {:customer (pull (from :customers [{:xt/id $cid} customer-name city]) {:args [{:cid customer-id}]})}) (return order-id customer))"}
