{"t01-project" "(from :customers [customer-name])"
 "t02-literal-filter" "(-> (from :customers [{:xt/id id} customer-name city]) (where (= city \"London\")) (return id customer-name))"
 "t03-where" "(-> (from :orders [{:xt/id id} order-value]) (where (> order-value 500)) (return id order-value))"
 "t04-order-limit" "(-> (from :orders [{:xt/id id} order-value]) (order-by {:val order-value :dir :desc}) (limit 2) (return id order-value))"
 "t05-offset" "(-> (from :orders [{:xt/id id} order-value]) (order-by order-value) (offset 1) (limit 2) (return id order-value))"
 "t06-aggregate-count" "(-> (from :orders [status]) (aggregate status {:n (row-count)}))"
 "t07-join-sum" "(-> (from :orders [customer-id order-value]) (aggregate {:customer-id customer-id :total (sum order-value)}) (join (from :customers [{:xt/id customer-id} customer-name]) [customer-name]) (return customer-name total))"
 "t08-left-join" "(-> (from :customers [{:xt/id customer-id} customer-name]) (left-join (from :orders [{:xt/id order-id} {:customer-id customer-id}]) [order-id]) (return customer-name order-id))"
 "t09-not-exists" "(-> (from :customers [{:xt/id customer-id} customer-name]) (where (not (exists? (from :orders [{:customer-id customer-id}])))) (return customer-name))"
 "t10-exists" "(-> (from :customers [{:xt/id customer-id} customer-name]) (where (exists? (-> (from :orders [{:customer-id customer-id} status]) (where (= status \"shipped\"))))) (aggregate customer-name))"
 "t11-unify-where-or" "(-> (from :orders [{:xt/id order-id} order-value {:customer-id customer-id}]) (unify (from :customers [{:xt/id customer-id} customer-name vip]) (where (or vip (> order-value 1000)))) (return {:order-id order-id} customer-name))"
 "t12-concat" "(-> (from :customers [customer-name city]) (return {:label (concat customer-name \" (\" city \")\")}))"
 "t13-star-without" "(-> (from :orders [xt/id customer-id order-value status]))"
 "t14-unnest" "(-> (from :orders [{:xt/id order-id} tags]) (unnest {:tag tags}) (return {:order-id order-id} tag))"
 "t15-rel" "(-> (unify (rel [{:product \"widget\" :category \"tools\"} {:product \"gadget\" :category \"toys\"}] [product category]) (from :prices [{:xt/id product} price])) (return product category price))"
 "t16-current-version" "(-> (from :prices [{:xt/id product} price]) (return product price))"
 "t17-valid-time-at" "(-> (from :prices {:bind [{:xt/id product} price] :for-valid-time [:at #inst \"2020-07-01T00:00:00Z\"]}) (return product price))"
 "t18-all-time-history" "(-> (from :prices {:bind [{:xt/id \"widget\"} price xt/valid-from xt/valid-to] :for-valid-time :all-time}) (order-by xt/valid-from) (return price {:valid-from xt/valid-from} {:valid-to xt/valid-to}))"
 "t19-valid-time-in" "(-> (from :prices {:bind [{:xt/id product} price] :for-valid-time [:in #inst \"2021-01-01T00:00:00Z\" #inst \"2022-01-01T00:00:00Z\"]}) (where (> price 40)) (aggregate product))"
 "t20-join-rename" "(-> (from :posts [title {:author-id customer-id}]) (join (from :customers [{:xt/id customer-id} customer-name]) [customer-name]) (return title customer-name))"
 "t21-count-with-zero" "(-> (from :posts [{:xt/id post-id} title]) (left-join (-> (from :comments [post-id]) (aggregate post-id {:n (row-count)})) [n]) (return title {:n (coalesce n 0)}))"
 "t22-nested-field" "(-> (from :posts [title meta]) (where (= (. meta :lang) \"en\")) (return title))"
 "t23-siblings-left-join" "(-> (from :people [{:xt/id person} parent]) (left-join (-> (from :people [{:xt/id sibling} parent]) (where (<> sibling person))) [sibling]) (return {:person person} sibling))"
 "t24-avg" "(-> (from :posts [{:xt/id post-id} title]) (join (-> (from :comments [post-id rating]) (aggregate post-id {:avg-rating (avg rating)})) [avg-rating]) (return title avg-rating))"
 "t25-order-desc" "(-> (from :customers [customer-name]) (order-by {:val customer-name :dir :desc}))"
 "t26-max-no-group" "(-> (from :orders [order-value]) (aggregate {:max-value (max order-value)}))"
 "t27-count-distinct" "(-> (from :customers [city]) (aggregate {:n (count-distinct city)}))"
 "t28-array-contains" "(-> (from :orders [{:xt/id order-id} tags]) (unnest {:tag tags}) (where (= tag \"gift\")) (aggregate order-id))"
 "t29-arithmetic" "(-> (from :orders [{:xt/id order-id} order-value]) (return {:order-id order-id} order-value {:tax (/ (* order-value 20) 100)}))"
 "t30-like" "(-> (from :customers [customer-name]) (where (or (like customer-name \"C%\") (like customer-name \"D%\"))))"
 "t31-scalar-subquery" "(-> (from :orders [{:xt/id order-id} {:customer-id cid}]) (return {:order-id order-id} {:customer-name (sq (-> (from :customers [{:xt/id cid} customer-name]) (return customer-name)))}))"
 "t32-exists-filtered" "(-> (from :posts [{:xt/id post-id} title]) (where (exists? (-> (from :comments [{:post-id post-id} rating]) (where (= rating 5))))) (return title))"
 "t33-nested-compare" "(-> (from :posts [title meta]) (where (> (. meta :words) 100)) (return title))"
 "t34-subquery-count-filter" "(-> (from :customers [{:xt/id cid} customer-name]) (where (>= (sq (-> (from :orders [{:customer-id cid}]) (aggregate {:n (row-count)}) (return n))) 2)) (return customer-name))"
 "t35-subquery-max" "(-> (from :customers [{:xt/id cid} customer-name]) (return customer-name {:top (sq (-> (from :orders [{:customer-id cid} order-value]) (aggregate {:top (max order-value)}) (return top)))}))"
 "t36-not-exists-filtered" "(-> (from :customers [{:xt/id cid} customer-name]) (where (not (exists? (-> (from :orders [{:customer-id cid} status]) (where (= status \"pending\")))))) (return customer-name))"
 "t37-exists-two-args" "(-> (from :customers [{:xt/id cid} customer-name city]) (where (exists? (-> (from :customers [{:xt/id other} {:city oc} vip]) (where (and vip (= oc city) (<> other cid)))))) (return customer-name))"
 "t38-count-zero" "(-> (from :customers [{:xt/id cid} customer-name]) (return customer-name {:n (sq (-> (from :orders [{:customer-id cid} status]) (where (= status \"shipped\")) (aggregate {:n (row-count)}) (return n)))}))"
 "t39-above-average" "(-> (from :orders [{:xt/id id} order-value]) (where (> order-value (sq (-> (from :orders [{:order-value other}]) (aggregate {:a (avg other)}) (return a))))) (return id order-value))"
 "t40-argmax-per-group" "(-> (from :orders [{:xt/id order-id} {:customer-id cid} order-value]) (where (= order-value (sq (-> (from :orders [{:customer-id cid} {:order-value m}]) (aggregate {:m (max m)}) (return m))))) (join (from :customers [{:xt/id cid} customer-name]) [customer-name]) (return customer-name order-id))"
 "t41-with-without-nested" "(-> (from :posts [xt/id title author-id meta]) (return xt/id title author-id {:lang (. meta :lang)}))"
 "t42-nested-group" "(-> (from :posts [meta]) (aggregate {:lang (. meta :lang) :total (sum (. meta :words))}))"
 "t43-nested-employee" "(-> (from :employees [name address]) (where (= (. address :country) \"UK\")) (return name))"
 "t44-vector-first" "(-> (from :orders [{:xt/id order-id} tags]) (return {:order-id order-id} {:first-tag (nth tags 0)}))"
 "t45-vector-length" "(-> (from :orders [{:xt/id order-id} tags]) (return {:order-id order-id} {:n (cardinality tags)}))"
 "t46-unnest-count" "(-> (from :orders [{:xt/id order-id} tags]) (unnest {:tag tags}) (aggregate tag {:n (count-distinct order-id)}))"
 "t47-unnest-employees" "(-> (from :employees [{:xt/id eid} skills]) (unnest {:skill skills}) (aggregate skill {:n (count-distinct eid)}))"
 "t48-rel-literal-join" "(-> (unify (from :customers [customer-name city]) (rel [{:city \"London\" :country \"UK\"} {:city \"Paris\" :country \"France\"}] [city country])) (return customer-name country))"
 "t49-parameter" "(-> (from :orders [{:xt/id order-id} order-value]) (where (>= order-value $min-value)) (return order-id))"
 "t50-valid-time-from" "(-> (from :prices {:bind [{:xt/id product} price] :for-valid-time [:in #inst \"2022-06-01T00:00:00Z\" nil]}) (return product price))"
 "t51-current-since" "(-> (from :prices [{:xt/id product} xt/valid-from]) (return product {:since xt/valid-from}))"
 "t52-min-ever" "(-> (from :prices {:bind [{:xt/id product} price] :for-valid-time :all-time}) (aggregate product {:lowest (min price)}))"
 "t53-salary-at" "(-> (unify (from :employees [{:xt/id eid} name]) (from :salaries {:bind [{:xt/id eid} salary] :for-valid-time [:at #inst \"2022-06-01T00:00:00Z\"]})) (return name salary))"
 "t54-system-time-all" "(-> (from :salaries {:bind [{:xt/id \"e3\"} salary] :for-valid-time [:at #inst \"2022-06-01T00:00:00Z\"] :for-system-time :all-time}) (aggregate salary))"
 "t55-top-salaries" "(-> (unify (from :employees [{:xt/id eid} name]) (from :salaries [{:xt/id eid} salary])) (order-by {:val salary :dir :desc}) (limit 2) (return name salary))"
 "t56-left-join-manager" "(-> (from :employees [{:xt/id eid} name {:manager-id mid}]) (left-join (from :employees [{:xt/id mid} {:name manager-name}]) [manager-name]) (return name manager-name))"
 "t57-grand-manager" "(-> (from :employees [{:xt/id eid} name {:manager-id mid}]) (join (from :employees [{:xt/id mid} {:manager-id gid}]) [gid]) (join (from :employees [{:xt/id gid} {:name grand-manager}]) [grand-manager]) (return name grand-manager))"
 "t58-all-reports" "(-> (union-all (unify (from :employees [name {:manager-id \"e1\"}])) (unify (from :employees [name {:manager-id m1}]) (from :employees [{:xt/id m1} {:manager-id \"e1\"}])) (unify (from :employees [name {:manager-id m2}]) (from :employees [{:xt/id m2} {:manager-id m1}]) (from :employees [{:xt/id m1} {:manager-id \"e1\"}]))) (return name))"
 "t59-pull-many" "(-> (from :posts [{:xt/id post-id} title]) (with {:comments (pull* (-> (from :comments [{:post-id post-id} body rating]) (order-by {:val rating :dir :desc}) (return body rating)))}) (return title comments))"
 "t60-pull-one" "(-> (from :orders [{:xt/id order-id} {:customer-id cid}]) (return {:order-id order-id} {:customer (pull (-> (from :customers [{:xt/id cid} customer-name city]) (return customer-name city)))}))"}
