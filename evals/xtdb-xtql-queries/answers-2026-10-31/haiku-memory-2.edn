{"t01-project" "(from :customers [customer-name])"
"t02-literal-filter" "(-> (from :customers [{:xt/id id} customer-name city]) (where (= city \"London\")) (return id customer-name))"
"t03-where" "(-> (from :orders [{:xt/id id} order-value]) (where (> order-value 500)) (return id order-value))"
"t04-order-limit" "(-> (from :orders [{:xt/id id} order-value]) (order-by {:val order-value :dir :desc}) (limit 2) (return id order-value))"
"t05-offset" "(-> (from :orders [{:xt/id id} order-value]) (order-by order-value) (offset 1) (limit 2) (return id order-value))"
"t06-aggregate-count" "(-> (from :orders [status]) (aggregate {:status status :n (row-count)}))"
"t07-join-sum" "(-> (from :orders [customer-id order-value]) (aggregate {:cid customer-id :total (sum order-value)}) (join (from :customers [{:xt/id cid} customer-name]) [cid]) (return customer-name total))"
"t08-left-join" "(-> (from :customers [{:xt/id cid} customer-name]) (left-join (from :orders [{:xt/id order-id} {:customer-id cid}]) [cid]) (return customer-name order-id))"
"t09-not-exists" "(-> (from :customers [{:xt/id cid} customer-name]) (where (not (exists? (from :orders [{:customer-id cid}])))) (return customer-name))"
"t10-exists" "(-> (from :customers [{:xt/id cid} customer-name]) (where (exists? (-> (from :orders [{:customer-id cid} status]) (where (= status \"shipped\"))))) (aggregate [customer-name]))"
"t11-unify-where-or" "(-> (from :orders [{:xt/id order-id} order-value {:customer-id cid}]) (join (from :customers [{:xt/id cid} customer-name vip]) [cid]) (where (or (= vip true) (> order-value 1000))) (return order-id customer-name))"
"t12-concat" "(-> (from :customers [customer-name city]) (return {:label (concat customer-name \" (\" city \")\")}))"
"t13-star-without" "(from :orders [xt/id customer-id order-value status])"
"t14-unnest" "(-> (from :orders [{:xt/id order-id} tags]) (unnest {:tag tags}) (return order-id tag))"
"t15-rel" "(-> (rel [{:product \"widget\" :category \"tools\"} {:product \"gadget\" :category \"toys\"}] [product category]) (join (from :prices [{:xt/id product} price]) [product]) (return product category price))"
"t16-current-version" "(from :prices [{:xt/id product} price])"
"t17-valid-time-at" "(from :prices {:bind [{:xt/id product} price] :for-valid-time [:at #inst \"2020-07-01T00:00:00Z\"]})"
"t18-all-time-history" "(-> (from :prices {:bind [{:xt/id product} price {:xt/valid-from valid-from} {:xt/valid-to valid-to}] :for-valid-time :all-time}) (where (= product \"widget\")) (order-by valid-from) (return price valid-from valid-to))"
"t19-valid-time-in" "(-> (from :prices {:bind [{:xt/id product} price] :for-valid-time [:in #inst \"2021-01-01T00:00:00Z\" #inst \"2022-01-01T00:00:00Z\"]}) (where (> price 40)) (aggregate [product]))"
"t20-join-rename" "(-> (from :posts [title {:author-id cid}]) (join (from :customers [{:xt/id cid} customer-name]) [cid]) (return title customer-name))"
"t21-count-with-zero" "(-> (from :posts [{:xt/id post-id} title]) (left-join (from :comments [{:xt/id cmt-id} {:post-id post-id}]) [post-id]) (aggregate {:title title :n (count cmt-id)}))"
"t22-nested-field" "(-> (from :posts [title {:meta {:lang lang}}]) (where (= lang \"en\")) (return title))"
"t23-siblings-left-join" "(-> (from :people [{:xt/id person} parent]) (left-join (from :people [{:xt/id sibling} parent]) [parent]) (where (or (= sibling nil) (<> person sibling))) (return person sibling))"
"t24-avg" "(-> (from :comments [{:post-id post-id} rating]) (aggregate {:post-id post-id :avg-rating (avg rating)}) (join (from :posts [{:xt/id post-id} title]) [post-id]) (return title avg-rating))"
"t25-order-desc" "(-> (from :customers [customer-name]) (order-by {:val customer-name :dir :desc}))"
"t26-max-no-group" "(-> (from :orders [order-value]) (aggregate {:max-value (max order-value)}))"
"t27-count-distinct" "(-> (from :customers [city]) (aggregate {:n (count-distinct city)}))"
"t28-array-contains" "(-> (from :orders [{:xt/id order-id} tags]) (unnest {:tag tags}) (where (= tag \"gift\")) (aggregate [order-id]))"
"t29-arithmetic" "(-> (from :orders [{:xt/id order-id} order-value]) (return order-id order-value {:tax (* order-value 0.2)}))"
"t30-like" "(-> (from :customers [customer-name]) (where (or (like customer-name \"C%\") (like customer-name \"D%\"))))"
"t31-scalar-subquery" "(-> (from :orders [{:xt/id order-id} {:customer-id cid}]) (return order-id {:customer-name (q (-> (from :customers [{:xt/id cid} customer-name]) (return customer-name)))}))"
"t32-exists-filtered" "(-> (from :posts [{:xt/id post-id} title]) (where (exists? (-> (from :comments [{:post-id post-id} rating]) (where (= rating 5))))) (return title))"
"t33-nested-compare" "(-> (from :posts [title {:meta {:words words}}]) (where (> words 100)) (return title))"
"t34-subquery-count-filter" "(-> (from :customers [{:xt/id cid} customer-name]) (with {:n-orders (q (-> (from :orders [{:customer-id cid}]) (aggregate {:n (row-count)}) (return n)))}) (where (>= n-orders 2)) (return customer-name))"
"t35-subquery-max" "(-> (from :customers [{:xt/id cid} customer-name]) (return customer-name {:top (q (-> (from :orders [{:customer-id cid} order-value]) (aggregate {:top (max order-value)}) (return top)))}))"
"t36-not-exists-filtered" "(-> (from :customers [{:xt/id cid} customer-name]) (where (not (exists? (-> (from :orders [{:customer-id cid} status]) (where (= status \"pending\")))))) (return customer-name))"
"t37-exists-two-args" "(-> (from :customers [{:xt/id cid} customer-name city]) (where (exists? (-> (from :customers [{:xt/id oid} city vip]) (where (= vip true) (<> oid cid))))) (return customer-name))"
"t38-count-zero" "(-> (from :customers [{:xt/id cid} customer-name]) (left-join (-> (from :orders [{:customer-id cid} status]) (where (= status \"shipped\")) (aggregate {:cid cid :n (row-count)})) [cid]) (return customer-name {:n (coalesce n 0)}))"
"t39-above-average" "(-> (from :orders [{:xt/id id} order-value]) (where (> order-value (q (-> (from :orders [{:order-value v}]) (aggregate {:a (avg v)}) (return a))))) (return id order-value))"
"t40-argmax-per-group" "(-> (from :orders [{:xt/id order-id} order-value {:customer-id cid}]) (where (= order-value (q (-> (from :orders [{:customer-id cid} {:order-value v}]) (aggregate {:m (max v)}) (return m))))) (join (from :customers [{:xt/id cid} customer-name]) [cid]) (return customer-name order-id))"
"t41-with-without-nested" "(from :posts [xt/id title author-id {:meta {:lang lang}}])"
"t42-nested-group" "(-> (from :posts [{:meta {:lang lang :words words}}]) (aggregate {:lang lang :total (sum words)}))"
"t43-nested-employee" "(-> (from :employees [name {:address {:country country}}]) (where (= country \"UK\")) (return name))"
"t44-vector-first" "(-> (from :orders [{:xt/id order-id} tags]) (return order-id {:first-tag (nth tags 0)}))"
"t45-vector-length" "(-> (from :orders [{:xt/id order-id} tags]) (return order-id {:n (array-length tags)}))"
"t46-unnest-count" "(-> (from :orders [{:xt/id order-id} tags]) (unnest {:tag tags}) (aggregate {:tag tag :n (count order-id)}))"
"t47-unnest-employees" "(-> (from :employees [{:xt/id eid} skills]) (unnest {:skill skills}) (aggregate {:skill skill :n (count eid)}))"
"t48-rel-literal-join" "(-> (rel [{:city \"London\" :country \"UK\"} {:city \"Paris\" :country \"France\"}] [city country]) (join (from :customers [customer-name city]) [city]) (return customer-name country))"
"t49-parameter" "(-> (from :orders [{:xt/id order-id} order-value]) (where (>= order-value $min-value)) (return order-id))"
"t50-valid-time-from" "(from :prices {:bind [{:xt/id product} price] :for-valid-time [:in #inst \"2022-06-01T00:00:00Z\" nil]})"
"t51-current-since" "(from :prices [{:xt/id product} {:xt/valid-from since}])"
"t52-min-ever" "(-> (from :prices {:bind [{:xt/id product} price] :for-valid-time :all-time}) (aggregate {:product product :lowest (min price)}))"
"t53-salary-at" "(-> (from :salaries {:bind [{:xt/id eid} salary] :for-valid-time [:at #inst \"2022-06-01T00:00:00Z\"]}) (join (from :employees [{:xt/id eid} name]) [eid]) (return name salary))"
"t54-system-time-all" "(-> (from :salaries {:bind [{:xt/id eid} salary] :for-valid-time [:at #inst \"2022-06-01T00:00:00Z\"] :for-system-time :all-time}) (where (= eid \"e3\")) (aggregate [salary]))"
"t55-top-salaries" "(-> (from :salaries [{:xt/id eid} salary]) (join (from :employees [{:xt/id eid} name]) [eid]) (order-by {:val salary :dir :desc}) (limit 2) (return name salary))"
"t56-left-join-manager" "(-> (from :employees [name {:xt/id eid} {:manager-id mid}]) (left-join (from :employees [{:xt/id mid} {:name manager-name}]) [mid]) (return name manager-name))"
"t57-grand-manager" "(-> (from :employees [name {:manager-id mid}]) (join (from :employees [{:xt/id mid} {:manager-id gid}]) [mid]) (join (from :employees [{:xt/id gid} {:name grand-manager}]) [gid]) (return name grand-manager))"
"t58-all-reports" "(-> (unify (-> (from :employees [{:xt/id eid} name {:manager-id mid}]) (where (= mid \"e1\")) (return eid name)) (-> (from :employees [{:xt/id eid} name {:manager-id mid}]) (join (-> (from :employees [{:xt/id mid} {:manager-id mm}]) (where (= mm \"e1\"))) [mid]) (return eid name)) (-> (from :employees [{:xt/id eid} name {:manager-id mid}]) (join (-> (from :employees [{:xt/id mid} {:manager-id m2}]) (join (-> (from :employees [{:xt/id m2} {:manager-id mm}]) (where (= mm \"e1\"))) [m2])) [mid]) (return eid name))) (return name))"
"t59-pull-many" "(-> (from :posts [{:xt/id pid} title]) (pull* {:comments (-> (from :comments [{:post-id pid} body rating]) (order-by {:val rating :dir :desc}) (return body rating))}) (return title comments))"
"t60-pull-one" "(-> (from :orders [{:xt/id order-id} {:customer-id cid}]) (pull {:customer (-> (from :customers [{:xt/id cid} customer-name city]) (return customer-name city))}) (return order-id customer))"}
