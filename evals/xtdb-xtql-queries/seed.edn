;; Fixture for the XTQL eval: XTDB transactions, submitted in order by
;; `clojure -M:eval seed`. Each table's columns are listed in tasks.edn.
;; Seeding twice leaves every current and valid-time answer unchanged; it
;; only adds system-time versions, so no task counts those.
[[[:put-docs :customers
   {:xt/id 1, :customer-name "Ada", :city "London", :vip true}
   {:xt/id 2, :customer-name "Brian", :city "Paris", :vip false}
   {:xt/id 3, :customer-name "Chen", :city "London", :vip false}
   {:xt/id 4, :customer-name "Dana", :city "Berlin", :vip true}]

  [:put-docs :orders
   {:xt/id 101, :customer-id 1, :order-value 250, :status "shipped", :tags ["gift" "express"]}
   {:xt/id 102, :customer-id 1, :order-value 1200, :status "pending", :tags ["bulk"]}
   {:xt/id 103, :customer-id 2, :order-value 80, :status "shipped", :tags []}
   {:xt/id 104, :customer-id 3, :order-value 400, :status "cancelled", :tags ["express"]}
   {:xt/id 105, :customer-id 2, :order-value 610, :status "shipped", :tags ["gift"]}]

  [:put-docs :posts
   {:xt/id "p1", :title "Hello", :author-id 1, :meta {:lang "en", :words 120}}
   {:xt/id "p2", :title "Bonjour", :author-id 2, :meta {:lang "fr", :words 300}}
   {:xt/id "p3", :title "Quiet", :author-id 4, :meta {:lang "en", :words 40}}]

  [:put-docs :comments
   {:xt/id "c1", :post-id "p1", :body "nice", :rating 5}
   {:xt/id "c2", :post-id "p1", :body "meh", :rating 2}
   {:xt/id "c3", :post-id "p2", :body "super", :rating 4}]

  [:put-docs :people
   {:xt/id "alice", :parent "zoe"}
   {:xt/id "bob", :parent "zoe"}
   {:xt/id "carol", :parent "yan"}
   {:xt/id "dave", :parent "xu"}
   {:xt/id "erin", :parent "yan"}]]

 ;; Bitemporal history: the price of each product over valid time.
 [[:put-docs {:into :prices, :valid-from #inst "2020-01-01", :valid-to #inst "2021-01-01"} {:xt/id "widget", :price 10}]
  [:put-docs {:into :prices, :valid-from #inst "2020-06-01", :valid-to #inst "2022-01-01"} {:xt/id "gadget", :price 50}]]
 [[:put-docs {:into :prices, :valid-from #inst "2021-01-01", :valid-to #inst "2023-01-01"} {:xt/id "widget", :price 12}]]
 [[:put-docs {:into :prices, :valid-from #inst "2023-01-01"} {:xt/id "widget", :price 15}]
  [:put-docs {:into :prices, :valid-from #inst "2022-01-01"} {:xt/id "gadget", :price 45}]]

 ;; A reporting chain four levels deep (Grace > Hal > Iris > Lee), with a
 ;; nested address map and a skills vector. Grace has no manager-id.
 [[:put-docs :employees
   {:xt/id "e1", :name "Grace", :dept "eng", :address {:city "London", :country "UK"}, :skills ["clojure" "rust"]}
   {:xt/id "e2", :name "Hal", :manager-id "e1", :dept "eng", :address {:city "Leeds", :country "UK"}, :skills ["clojure"]}
   {:xt/id "e3", :name "Iris", :manager-id "e2", :dept "eng", :address {:city "Paris", :country "FR"}, :skills ["rust" "go"]}
   {:xt/id "e4", :name "Jon", :manager-id "e1", :dept "ops", :address {:city "London", :country "UK"}, :skills []}
   {:xt/id "e5", :name "Kim", :manager-id "e4", :dept "ops", :address {:city "Berlin", :country "DE"}, :skills ["go"]}
   {:xt/id "e6", :name "Lee", :manager-id "e3", :dept "eng", :address {:city "Paris", :country "FR"}, :skills ["clojure" "go"]}]

  ;; Salaries over valid time, keyed by employee id.
  [:put-docs {:into :salaries, :valid-from #inst "2021-01-01"} {:xt/id "e1", :salary 90000}]
  [:put-docs {:into :salaries, :valid-from #inst "2022-01-01"} {:xt/id "e2", :salary 50000} {:xt/id "e3", :salary 60000}]]
 [[:put-docs {:into :salaries, :valid-from #inst "2023-01-01"} {:xt/id "e2", :salary 55000}]]
 ;; A retroactive correction, recorded later in system time: Iris's 2022
 ;; salary was really 62000. The 60000 record for 2022 stays in system-time
 ;; history.
 [[:put-docs {:into :salaries, :valid-from #inst "2022-01-01", :valid-to #inst "2023-01-01"} {:xt/id "e3", :salary 62000}]]]
