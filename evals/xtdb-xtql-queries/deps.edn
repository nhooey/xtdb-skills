;; The XTQL eval: `clojure -M:eval <command>` from this directory.
;; xtdb-api's client needs next.jdbc, which the api's own build only uses for
;; its tests, so it is added here at the version XTDB v2.1.0 pins.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        com.xtdb/xtdb-api {:mvn/version "2.1.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}}
 :aliases {:eval {:main-opts ["-m" "xtql-eval"]}}}
