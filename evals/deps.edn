;; The skill evals: `clojure -M:eval <command> <suite>` from this directory.
;; xtdb-api's client needs next.jdbc, which the api's own build only uses for
;; its tests, so it is added here at the version XTDB v2.2.0 pins. xtdb-core
;; is for the storage checks that start a node in the eval's own process.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        com.xtdb/xtdb-api {:mvn/version "2.2.0"}
        com.xtdb/xtdb-core {:mvn/version "2.2.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1093"}}
 :aliases {:eval {:main-opts ["-m" "xtdb-eval"]}}}
