;; Spans of xtdb/xtdb this skill cites (:cite) and eval checks it cites for
;; behaviour no source states (:observed), made by the eval's `storage`
;; command without a container. The Arrow citations name their own :source,
;; the arrow-java version XTDB v2.2.0 builds against, and the tools.build
;; ones the version the eval builds uberjars with. See the README's "Citing
;; XTDB sources" for the anchor kinds.
{:source {:repo "xtdb/xtdb"
          :tag "v2.2.0"
          :watch ["core/src/main/clojure/xtdb/node.clj"
                  "core/src/main/clojure/xtdb/log.clj"
                  "core/src/main/clojure/xtdb/buffer_pool.clj"
                  "core/src/main/clojure/xtdb/pgwire.clj"
                  "core/src/main/clojure/xtdb/flight_sql.clj"
                  "core/src/main/kotlin/xtdb/api/Xtdb.kt"
                  "core/src/main/kotlin/xtdb/api/ServerConfig.kt"
                  "core/src/main/kotlin/xtdb/api/FlightSqlConfig.kt"
                  "core/src/main/kotlin/xtdb/api/storage/Storage.kt"
                  "core/src/main/java/org/apache/arrow/memory/BufferLedger.java"
                  "core/build.gradle.kts"
                  "gradle/libs.versions.toml"
                  "build.gradle.kts"
                  "docs/src/content/docs/drivers/clojure.md"]}

 :observed-on "XTDB"
 :observations "../../evals/xtdb-embedded-node/examples.edn"
 :observed-by "storage"

