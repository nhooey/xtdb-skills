;; The spans of xtdb/xtdb this skill cites, one :cite per footnote id, and
;; the eval examples it cites for behaviour no source states, one :observed
;; per footnote id. A claim about XTDB 1 cites the last 1.x release, 1.24.5,
;; through its own :source; every other claim cites :tag. `skill-citations
;; lock` resolves each :cite anchor, records its lines and hash in
;; citations.lock.json, and regenerates the footnote definitions in
;; SKILL.md; `drift` resolves the 2.x ones again at a newer tag. :observed
;; examples are re-run by the eval's `examples` command.
;;
;; Anchors: :heading (a Markdown heading's text), :form (the start of a
;; top-level form in column 0) or :line (text on exactly one line). The 1.x
;; docs are AsciiDoc, which :heading doesn't read, so they're cited by :line.

{:source {:repo "xtdb/xtdb"
          :tag "v2.2.0"
          ;; Changes under these paths that no citation covers are reported as gaps.
          :watch ["api/src/main/clojure/xtdb/api.clj"
                  "api/src/main/clojure/xtdb/tx_ops.clj"
                  "core/src/main/clojure/xtdb/xtql.clj"
                  "docs/src/content/docs/reference/main/xtql/"]}

